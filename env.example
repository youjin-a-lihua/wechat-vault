# 微信数据方舟 · 环境变量示例
# 复制为 deploy/.env 并填入你自己的值（.env 已被 .gitignore 忽略）
# 下面全部是占位值，其中 192.0.2.x 是 RFC 5737 文档保留地址，请务必替换

# ── 必填 ──────────────────────────────────────────────
# NAS / 主机的局域网地址（方舟只绑这个地址，绝不绑 0.0.0.0）
WV_BIND_IP=192.0.2.10
# KasmVNC 桌面口令（同时也是微信容器内桌面登录口令）
WV_PASSWORD=change-me
# KasmVNC 桌面用户名
WV_DESKTOP_USER=your_user

# ── 查看器鉴权（可选；留空则仅靠 WV_ALLOW_CIDRS 网段白名单）──
# 生成方式：python -c "import wv_auth;print(wv_auth.hash_password('你的口令'))"
WV_PASSWORD_HASH=
WV_SECRET=

# ── 允许访问的网段（逗号分隔）──────────────────────────
# 默认只允许本机 + 私有网段；可收窄为你的具体网段
WV_ALLOW_CIDRS=127.0.0.1/32,192.168.0.0/16

# ── 运行期（一般不用改）────────────────────────────────
WV_PORT=8790
WV_KASMVNC_PORT=13000
WV_MEDIA=/data/media
WV_PLAIN_DBS=/data/wx_backup/plain_dbs

# ── 时区（重要：非中国时区必须改）──────────────────────
# 消息时间展示、按日期归档、微信分库月份匹配都按它换算。
# 默认 8（东八区）。海外填自己的偏移，支持小数：日本 9、印度 5.5、纽约 -5。
# 配错的症状是「所有消息时间整体差几小时」和「图片按月份找不到」。
WV_TZ_OFFSET=8

# ── 自动同步（默认开启，一般不用改）────────────────────
# 关掉：WV_AUTOSYNC=0；轮询间隔 / 写入稳定判定（秒）
# WV_AUTOSYNC_POLL=60
# WV_AUTOSYNC_STABLE=30
